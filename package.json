{
  "name": "ucamedya-ai-growth-studio",
  "productName": "UcaMedya AI Growth Studio",
  "version": "0.2.4",
  "description": "UcaMedya için yapay zekâ destekli müşteri bulma, web sitesi analizi, satış ve ajans yönetim uygulaması",
  "author": "UcaMedya",
  "license": "UNLICENSED",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "node scripts/build-wp-plugin.mjs && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e-smoke.mjs",
    "icons": "electron scripts/make-icons.cjs",
    "dist": "npm run build && electron-builder --win nsis --x64 --publish never",
    "dist:dir": "npm run build && electron-builder --win dir --x64 --publish never",
    "dist:mac": "npm run build && electron-builder --mac dmg --x64 --arm64 --publish never",
    "build:wp": "node scripts/build-wp-plugin.mjs"
  },
  "devDependencies": {
    "@fontsource/inter-tight": "^5.2.6",
    "@fontsource/outfit": "^5.2.6",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "three": "^0.180.0",
    "typescript": "5.9",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "cheerio": "^1.2.0",
    "exceljs": "^4.4.0",
    "imapflow": "^2.4.0",
    "nodemailer": "^10.1.0",
    "playwright-core": "^1.64.0",
    "zod": "^4.6.7"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  }
}
